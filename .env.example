# Local development data location. The API token is supplied by Doppler;
# do not put a real token in a .env file.
REP_PILOT_DATA_DIR=.repopilot
# Optional OpenAI-compatible answer generation; local retrieval works without these.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

