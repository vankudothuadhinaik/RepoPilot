{
  "title": "RepoPilot synthetic retrieval benchmark",
  "version": 1,
  "description": "Fifteen hand-authored synthetic source files across three repositories; 45 targeted retrieval queries and five negative queries. Measures lexical retrieval behavior only, not semantic answer quality or real-world generalization.",
  "repositories": {
    "backend": {
      "src/auth.py": "Bearer credential rotation token validation rejects expired credentials and records authentication failures.",
      "src/database.py": "SQLite transaction wal checkpoint rollback savepoint handles database consistency and durability.",
      "src/indexer.py": "Contenthash incremental parserversion symbols qualified definitions skip unchanged parsing.",
      "src/search.py": "FTS5 bm25 ranking snippet query tokenizer fulltext retrieval result ordering.",
      "src/llm.py": "OpenAI grounding citation provider response validates cited paths and abstains on unsupported answers."
    },
    "web": {
      "src/dashboard.tsx": "Repository selector reindex delta unchanged added updated removed file counts.",
      "src/client.ts": "Fetch timeout retry response header request transport and API error handling.",
      "src/styles.css": "Responsive dark theme palette spacing typography accessible mobile layout.",
      "package.json": "Vite TypeScript React dependency production build tooling frontend package.",
      "src/evidence.tsx": "Line citation sha256 indexed commit snippet source provenance evidence viewer."
    },
    "infra": {
      "Dockerfile": "Container image python runtime nonroot user health endpoint application startup.",
      "compose.yaml": "Service volume network healthcheck environment dependency orchestration.",
      "ci.yml": "Pytest ruff coverage compile evaluation artifact continuous integration pipeline.",
      "codeql.yml": "Codeql static analysis security query workflow SARIF scanning configuration.",
      "SECURITY.md": "Path traversal symlink redaction secret exclusion local trust boundary threat model."
    }
  },
  "cases": [
    {
      "id": "retrieval-001",
      "repo": "backend",
